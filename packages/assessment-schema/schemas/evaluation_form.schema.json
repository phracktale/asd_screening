{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/tsa-assessment-form-v1.json",
  "title": "Formulaire structuré de repérage TSA",
  "description": "Schéma de recueil clinique original. Ce formulaire n'est pas un instrument diagnostique ou psychométrique validé.",
  "type": "object",
  "required": ["schema_version", "assessment", "consents", "context", "responses"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "assessment": {
      "type": "object",
      "required": ["id", "started_at", "respondent_type", "age_band", "mode"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": ["string", "null"], "format": "date-time"},
        "respondent_type": {
          "enum": ["self", "parent", "partner", "relative", "caregiver", "clinician", "other"]
        },
        "age_band": {
          "enum": ["toddler", "child", "adolescent", "adult"]
        },
        "mode": {
          "enum": ["anonymous", "personal", "professional", "research"]
        },
        "language": {"type": "string", "default": "fr-FR"}
      },
      "additionalProperties": false
    },
    "consents": {
      "type": "object",
      "required": ["assessment", "privacy_notice"],
      "properties": {
        "assessment": {"type": "boolean"},
        "privacy_notice": {"type": "boolean"},
        "storage": {"type": "boolean", "default": false},
        "research": {"type": "boolean", "default": false},
        "document_analysis": {"type": "boolean", "default": false},
        "version": {"type": "string"},
        "granted_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "birth_year": {"type": ["integer", "null"], "minimum": 1900, "maximum": 2100},
        "age_years": {"type": ["number", "null"], "minimum": 0, "maximum": 120},
        "gender": {"type": ["string", "null"], "maxLength": 80},
        "sex_at_birth": {"enum": ["female", "male", "intersex", "unknown", null]},
        "primary_language": {"type": ["string", "null"], "maxLength": 80},
        "country_of_development": {"type": ["string", "null"], "maxLength": 120},
        "communication_level": {
          "enum": ["non_speaking", "single_words", "phrases", "fluent", "unknown", null]
        },
        "known_conditions": {
          "type": "array",
          "items": {"type": "string", "maxLength": 120},
          "uniqueItems": true
        },
        "reason_for_assessment": {"type": ["string", "null"], "maxLength": 4000},
        "urgent_risk": {
          "type": "object",
          "properties": {
            "suicidal_ideation": {"enum": ["yes", "no", "unknown"]},
            "immediate_danger": {"enum": ["yes", "no", "unknown"]},
            "acute_psychosis_or_mania": {"enum": ["yes", "no", "unknown"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "responses": {
      "type": "array",
      "items": {"$ref": "#/$defs/response"}
    },
    "instrument_results": {
      "type": "array",
      "items": {"$ref": "#/$defs/instrumentResult"}
    },
    "documents": {
      "type": "array",
      "items": {"$ref": "#/$defs/documentReference"}
    }
  },
  "$defs": {
    "period": {
      "enum": ["current", "childhood", "early_development", "lifetime", "not_applicable"]
    },
    "responseValue": {
      "oneOf": [
        {"type": "integer", "minimum": 0, "maximum": 4},
        {"enum": ["unknown", "not_applicable"]}
      ]
    },
    "response": {
      "type": "object",
      "required": ["question_code", "period", "value"],
      "properties": {
        "question_code": {
          "type": "string",
          "pattern": "^(A[1-3]|B[1-4]|C|D|E|F|G)\\.[0-9]{2}$"
        },
        "period": {"$ref": "#/$defs/period"},
        "value": {"$ref": "#/$defs/responseValue"},
        "age_of_onset": {"type": ["number", "null"], "minimum": 0, "maximum": 120},
        "contexts": {
          "type": "array",
          "items": {
            "enum": ["home", "school", "work", "friends", "family", "healthcare", "public", "online", "other"]
          },
          "uniqueItems": true
        },
        "impact": {"enum": ["none", "mild", "moderate", "important", "major", "unknown", null]},
        "example": {"type": ["string", "null"], "maxLength": 4000},
        "source_type": {
          "enum": ["self_report", "parent_report", "partner_report", "professional_observation", "school_record", "medical_record", "other", null]
        },
        "source_confidence": {"enum": ["low", "medium", "high", "unknown", null]},
        "answered_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    },
    "instrumentResult": {
      "type": "object",
      "required": ["instrument_code", "instrument_version", "date", "source"],
      "properties": {
        "instrument_code": {"type": "string", "maxLength": 80},
        "instrument_version": {"type": "string", "maxLength": 40},
        "language": {"type": "string", "maxLength": 20},
        "date": {"type": "string", "format": "date"},
        "raw_score": {"type": ["number", "null"]},
        "subscores": {"type": "object", "additionalProperties": {"type": "number"}},
        "interpretation": {"type": ["string", "null"], "maxLength": 2000},
        "source": {"enum": ["calculated_in_app", "entered_by_user", "entered_by_professional", "imported_document"]},
        "license_record_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "documentReference": {
      "type": "object",
      "required": ["id", "type", "uploaded_at"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "type": {
          "enum": ["school_record", "medical_report", "psychological_report", "speech_therapy", "occupational_therapy", "other"]
        },
        "filename": {"type": ["string", "null"], "maxLength": 255},
        "uploaded_at": {"type": "string", "format": "date-time"},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "analysis_allowed": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
